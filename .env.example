VITE_OPENAI_API_KEY=your-openai-api-key
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Dev only: Firebase Console test phone numbers + true skips SMS reCAPTCHA locally
# VITE_FIREBASE_PHONE_TEST_MODE=true

# Include /index.php unless Apache rewrite sends / to index.php (see api/.htaccess)
VITE_API_BASE_URL=https://api.zarkorea.com/index.php

# Optional: force the active country config (KR, US, JP). If unset, the app
# resolves the country from the URL path (e.g. /kr, /us) and falls back to
# KR. See src/config/country.js.
# VITE_ACTIVE_COUNTRY=KR

# Optional, local/staging QA only: also show disabled markets (currently JP)
# in the country selector. KR and US are already in ENABLED_COUNTRIES; JP
# stays route-testable at /jp. On /us the selector is locked to US via
# lockCountrySelector regardless of this flag. Never set in production.
# See ENABLED_COUNTRIES in src/config/country.js.
# VITE_SHOW_ALL_COUNTRIES=true
